{
  "name": "Recipe",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Recipe name"
    },
    "description": {
      "type": "string",
      "description": "Short description"
    },
    "image_url": {
      "type": "string",
      "description": "Photo URL of the dish"
    },
    "protein_source": {
      "type": "string",
      "enum": [
        "meat",
        "fish",
        "chicken",
        "dairy",
        "plant"
      ],
      "description": "Main protein source"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "hot",
        "breakfast",
        "snack"
      ],
      "description": "Type of meal"
    },
    "calories": {
      "type": "number",
      "description": "Calories per serving"
    },
    "protein": {
      "type": "number",
      "description": "Protein grams per serving"
    },
    "fat": {
      "type": "number",
      "description": "Fat grams per serving"
    },
    "carbs": {
      "type": "number",
      "description": "Carbs grams per serving"
    },
    "cook_time": {
      "type": "number",
      "description": "Cook time in minutes"
    },
    "servings": {
      "type": "number",
      "description": "Number of servings"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_number": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "protein_source",
    "meal_type"
  ]
}
